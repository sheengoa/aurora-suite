/* components/avatarNicknameModal/avatarNicknameModal.wxss */
.super-page-box {
	background-color: rgba(26, 28, 28, 0.52);
	position: fixed;
	inset: 0;
	width: 100vw;
	height: 100vh;
	z-index: 103;
	animation: modal-mask-in 180ms ease-out both;
}

@keyframes modal-mask-in {
	from { opacity: 0; }
	to { opacity: 1; }
}

@keyframes modal-sheet-in {
	from { transform: translateY(32rpx); }
	to { transform: translateY(0); }
}

.super-modal-box {
	position: fixed;
	z-index: 999;
	height: 76vh;
	max-height: calc(100vh - 80rpx);
	width: 100vw;
	bottom: 0rpx;
	left: 0rpx;
	animation: modal-sheet-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.super-modal-body-box {
	background-color: #ffffff;
	border-top-left-radius: 56rpx;
	border-top-right-radius: 56rpx;
	height: 100%;
	width: 100%;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.super-modal-title {
	height: 105rpx;
	width: 100%;
	font-size: 30rpx;
	font-weight: bold;
	color: #1a1c1c;
	position: relative;
}

.super-modal-content {
	height: 0;
	flex: 1;
	min-height: 0;
	padding-bottom: 20rpx;
	box-sizing: border-box;
}

.modal-close-hit {
	position: absolute;
	top: 8rpx;
	right: 10rpx;
	width: 88rpx;
	height: 88rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
}

.modal-close-hit image {
	width: 44rpx;
	height: 44rpx;
}

.super-avatar-box {
	width: 250rpx;
	position: relative;
	margin: auto;
	margin-top: 25rpx;
}

.avatar-btn {
	position: absolute;
	top: 0rpx;
	left: 0rpx;
	height: 100% !important;
	width: 100% !important;
	background-color: transparent;
	z-index: 99;
}

.avatar-img-box {
	background-color: #f5f5f5;
	height: 200rpx;
	width: 200rpx;
	border-radius: 20rpx;
	margin: auto;
}

.avatar-select-tips {
	font-size: 24rpx;
	color: #8a8a8a;
	margin-top: 15rpx;
}

.super-nick-name-box {
	height: 105rpx;
	padding: 0rpx 25rpx;
	margin-top: 15rpx;
	border-bottom: 1rpx solid #f0f0f0;
}

.nick-name-box {
	height: 100%;
	width: 85%;
}
.nick-name-input{
	height: 105rpx;
}

.super-phone-box {
	height: 105rpx;
	padding: 0rpx 25rpx;
	margin-top: 15rpx;
}

.phone-label-box {
	height: 100%;
	flex: 1;
}

.phone-display {
	font-size: 28rpx;
	color: #999;
}

.phone-btn {
	min-height: 88rpx;
	padding: 0 30rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background: #8c271e;
	color: white;
	font-size: 24rpx;
	border-radius: 26rpx;
	border: none;
	line-height: 1.5;
	width: 250rpx !important;
}

.soft-control-pressed {
	opacity: 0.72;
	background: #f0edeb;
}

.control-pressed {
	opacity: 0.76;
	transform: scale(0.98);
}

.phone-btn::after {
	border: none;
}

.apply-btn {
	width: 450rpx;
	height: 95rpx;
	border-radius: 26rpx;
	background: #8c271e;
	color: #ffffff;
	font-size: 28rpx;
	font-weight: bold;
	margin: 35rpx auto 30rpx;
	flex-shrink: 0;
}

.flex-ac,
.flex-jc-ac,
.flex-jb-ac {
	display: flex;
}

.flex-jc-ac {
	justify-content: center;
}

.flex-ac,
.flex-jc-ac,
.flex-jb-ac {
	align-items: center;
}

.flex-jb-ac {
	justify-content: space-between;
}
