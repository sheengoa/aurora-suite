.welcome-browse-hint { position: absolute; top: 28rpx; right: 0; left: 0; z-index: 5; display: flex; align-items: center; flex-direction: column; pointer-events: none; will-change: opacity; }
.welcome-gesture-lock { position: absolute; top: 0; right: 0; bottom: 0; left: 0; z-index: 8; touch-action: none; }
.browse-arrows { display: flex; align-items: center; flex-direction: column; color: #8c271e; opacity: 0.6; animation: aurora-browse-bounce 1s infinite; }
.browse-chevron { position: relative; display: block; width: 40rpx; height: 18rpx; }
.browse-chevron::before,
.browse-chevron::after { content: ''; position: absolute; top: 5rpx; width: 27rpx; height: 4rpx; background: currentColor; border-radius: 2rpx; }
.browse-chevron::before { right: 20rpx; transform: rotate(-42deg); transform-origin: right center; }
.browse-chevron::after { left: 20rpx; transform: rotate(42deg); transform-origin: left center; }
.browse-chevron.first { margin-bottom: 4rpx; }
.browse-chevron.second { width: 32rpx; height: 15rpx; margin-top: 0; }
.browse-chevron.second::before,
.browse-chevron.second::after { top: 4rpx; width: 22rpx; height: 4rpx; }
.browse-chevron.second::before { right: 16rpx; }
.browse-chevron.second::after { left: 16rpx; }
.browse-label { margin-top: 4px; color: #656461; font-family: Georgia, "Noto Serif SC", serif; font-size: 18rpx; letter-spacing: 0.1em; line-height: 1.5; }
@keyframes aurora-browse-bounce {
  0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }
  50% { transform: none; animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }
}

