/* pages/index/index.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
}

/* 状态栏占位 */
.status-bar {
  background: #8c271e;
}

/* 店名 */
.shop-header {
  background: #8c271e;
  padding: 24rpx 30rpx 28rpx;
  text-align: center;
}

.shop-name {
  color: white;
  font-size: 36rpx;
  font-weight: bold;
}

/* 搜索框 */
.search-wrapper {
  background: white;
  padding: 10rpx 0;
}

/* 主内容区 */
.main-content {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.menu-error-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  padding: 72rpx 48rpx 220rpx;
  text-align: center;
}

.menu-error-mark {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: #f7ebe8;
  color: #8c271e;
  font-size: 48rpx;
  font-weight: 700;
}

.menu-error-title {
  margin-top: 28rpx;
  color: #333;
  font-size: 32rpx;
  font-weight: 700;
}

.menu-error-description {
  margin-top: 12rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 1.5;
}

.menu-error-action {
  min-width: 208rpx;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #8c271e;
  color: white;
  font-size: 28rpx;
  font-weight: 700;
}

/* 左侧分类菜单 */
.menu-sidebar {
  width: 180rpx;
  background: white;
  border-right: 1rpx solid #f0f0f0;
  padding-bottom: 150rpx;
}

.menu-item {
  position: relative;
  text-align: center;
  background: white;
  transition: all 0.3s;
}

.menu-item.active {
  background: #f5f5f5;
}

.menu-name {
  font-size: 28rpx;
  color: #333;
}

.menu-item.active .menu-name {
  color: #8c271e;
  font-weight: bold;
}

.menu-indicator {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: #8c271e;
  border-radius: 0 6rpx 6rpx 0;
}

/* 右侧菜品列表 */
.goods-list {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 180rpx;
}

.goods-list-inner {
  min-height: 100%;
  will-change: transform;
}

.goods-section {
  min-height: 2rpx;
  padding-bottom: 4rpx;
}

.goods-section-title {
  padding: 8rpx 0 18rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 700;
}

.goods-section-title text {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 18rpx;
  border-radius: 6rpx;
  background: #fff3f0;
  color: #8c271e;
}

.goods-item {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.goods-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.previewable-image:active {
  opacity: 0.85;
}

.goods-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f1f1;
  color: #999;
  font-size: 24rpx;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}


.goods-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.sku-summary {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  color: #38b2ac;
  background: #edfafa;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.goods-footer {
  width: 100%;
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}

.goods-price {
  min-width: 0;
  flex: 1;
  color: #8c271e;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.goods-price .price-symbol {
  font-size: 24rpx;
  color: #8c271e;
  font-weight: bold;
}

.goods-price .price-num {
  font-size: 36rpx;
  color: #8c271e;
  font-weight: bold;
}

.price-prefix {
  font-size: 22rpx;
  color: #999;
}

.goods-actions {
  display: flex;
  align-items: center;
  gap: 15rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.section-empty,
.section-loading,
.section-end {
  padding: 34rpx 20rpx;
  text-align: center;
  color: #999;
  font-size: 24rpx;
}

.section-empty {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.menu-empty-state {
  min-height: 420rpx;
  padding: 64rpx 24rpx 148rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.menu-empty-icon {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8c271e;
  background: #f7ebe8;
  border-radius: 20rpx;
  font-size: 34rpx;
}

.menu-empty-title {
  margin-top: 18rpx;
  color: #1a1c1c;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-empty-copy {
  margin-top: 8rpx;
  color: #656461;
  font-size: 22rpx;
}

.action-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.action-btn.reduce {
  background: #f5f5f5;
  color: #666;
}

.action-btn.add {
  background: #8c271e;
  color: white;
}

.goods-count {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 悬浮购物车 */
.float-cart-wrapper {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 16rpx);
  z-index: 10;
}

.float-cart-card {
  background: white;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.cart-icon-wrapper {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: #f7ebe8;
  flex-shrink: 0;
}

.cart-icon {
  width: 45rpx;
  height: 45rpx;
}

.cart-badge {
  position: absolute;
  top: -5rpx;
  right: -5rpx;
  background: #8c271e;
  color: white;
  border-radius: 50%;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: bold;
  padding: 0 6rpx;
  border: 3rpx solid white;
}

.cart-info {
  flex: 1;
}

.cart-price {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 28rpx;
  color: #8c271e;
  margin-right: 5rpx;
  font-weight: bold;
}

.cart-price .price-symbol {
  font-size: 24rpx;
  color: #8c271e;
  font-weight: bold;
}

.cart-price .price-num {
  font-size: 32rpx;
  color: #8c271e;
  font-weight: bold;
}

.cart-tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.cart-right {
  flex-shrink: 0;
}

.settle-btn {
  min-width: 176rpx;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #e0e0e0;
  color: #999;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.3s;
}

.settle-btn.active {
  background: #8c271e;
  color: white;
}

/* 购物车详情弹窗 */
.cart-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
  background: rgba(0,0,0,0.5);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.cart-mask.show {
  opacity: 1;
  visibility: visible;
}

.cart-detail {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom));
  max-height: 70vh;
  background: white;
  border-radius: 20rpx 20rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.3s;
  display: flex;
  flex-direction: column;
}

.cart-detail.show {
  transform: translateY(0);
}

.cart-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-title {
  min-width: 0;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-clear {
  font-size: 28rpx;
  color: #8c271e;
}

.cart-content {
  flex: 1;
  padding: 20rpx 30rpx;
}

.cart-goods-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.cart-goods-info {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.cart-goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  margin-right: 20rpx;
}

.cart-goods-detail {
  flex: 1;
  min-width: 0;
}

.cart-goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 5rpx;
}

.cart-goods-sku {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 100%;
  box-sizing: border-box;
  padding: 2rpx 10rpx;
  border-radius: 5rpx;
  overflow: hidden;
  font-size: 23rpx;
  color: #38b2ac;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-goods-options {
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.tag-text {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  font-size: 22rpx;
  color: #8c271e;
  background: #fff3f0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cart-goods-price {
  font-size: 26rpx;
  color: #666;
}

.cart-goods-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.cart-count {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

/* 购物车底部栏 */
.cart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 30rpx;
  background: white;
  border-top: 2rpx solid #f5f5f5;
  flex-shrink: 0;
}

.cart-footer-left {
  display: flex;
  align-items: baseline;
  flex: 1;
}

.cart-total-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 10rpx;
}

.cart-total-price {
  display: flex;
  align-items: baseline;
}

.cart-total-price .price-symbol {
  font-size: 24rpx;
  color: #8c271e;
  font-weight: bold;
}

.cart-total-price .price-num {
  font-size: 36rpx;
  color: #8c271e;
  font-weight: bold;
}

.cart-footer-right {
  margin-left: 20rpx;
}

.cart-settle-btn {
  min-width: 176rpx;
  height: 88rpx;
  padding: 0 28rpx;
  background: #8c271e;
  color: white;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

/* 商品详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog.dish-detail-modal {
  width: 90%;
  max-height: 85vh;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: 300;
  z-index: 10;
  line-height: 1;
}

.modal-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

/* 商品信息头部 */
.dish-detail-header {
  margin-bottom: 30rpx;
}

.dish-detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.dish-detail-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f1f1;
  color: #999;
  font-size: 26rpx;
}

.dish-detail-info {
  padding: 0 10rpx;
}

.dish-detail-name {
  font-size: 36rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 15rpx;
}

.dish-detail-desc {
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
  margin-bottom: 15rpx;
}



.dish-detail-price {
  font-size: 40rpx;
  color: #8c271e;
  font-weight: bold;
}

.dish-detail-price .price-symbol {
  font-size: 28rpx;
}

/* 标签选择 */
.tag-section {
  margin-bottom: 30rpx;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
}

.tag-section:last-child {
  margin-bottom: 0;
}

.tag-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
}

.tag-type-label {
  font-size: 22rpx;
  color: #999;
  font-weight: normal;
  margin-left: 8rpx;
}

.tag-required-label {
  font-size: 22rpx;
  color: white;
  background: #8c271e;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-left: 10rpx;
  font-weight: normal;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.sku-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sku-option {
  min-width: 180rpx;
  padding: 18rpx 22rpx;
  background: white;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
}

.sku-option.selected {
  border-color: #8c271e;
  background: #fff3f0;
}

.sku-option-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.sku-option.selected .sku-option-name {
  color: #8c271e;
  font-weight: 600;
}

.sku-option-price {
  font-size: 24rpx;
  color: #8c271e;
  font-weight: 600;
}

.tag-option {
  padding: 16rpx 30rpx;
  background: white;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tag-option.selected {
  background: #8c271e;
  border-color: #8c271e;
  color: white;
  font-weight: bold;
}

/* 数量选择 */
.quantity-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx;
  background: #f9f9f9;
  border-radius: 16rpx;
  margin-top: 30rpx;
}

.quantity-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 30rpx;
}

.quantity-btn {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  background: transparent;
  color: #fff;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms ease;
}

.quantity-btn::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #8c271e;
  box-shadow: 0 8rpx 18rpx rgba(140, 39, 30, 0.2);
}

.quantity-btn.disabled {
  color: #999;
}

.quantity-btn.disabled::before {
  background: #e7e3e1;
  box-shadow: none;
}

.quantity-num {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  min-width: 60rpx;
  text-align: center;
}

/* 底部操作栏 */
.modal-footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: white;
  border-top: 2rpx solid #f5f5f5;
  flex-shrink: 0;
}

.footer-price {
  display: flex;
  align-items: baseline;
}

.total-label {
  font-size: 26rpx;
  color: #666;
  margin-right: 10rpx;
}

.footer-price .price-symbol {
  font-size: 24rpx;
  color: #8c271e;
  font-weight: bold;
}

.footer-price .price-num {
  font-size: 36rpx;
  color: #8c271e;
  font-weight: bold;
}

.add-cart-btn {
  min-width: 240rpx;
  height: 88rpx;
  padding: 0 40rpx;
  background: #8c271e;
  color: white;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
}

/* Aurora 迎宾原型：以门店照片、白色实底信息卡和菜单纸面形成同一连续场景。 */
.welcome-page {
  position: relative;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: #f9f9f9 !important;
}

.welcome-scene {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background: #f9f9f9;
}

.welcome-hero {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 0;
  overflow: hidden;
  background: #241b18;
}

.welcome-hero-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0.78;
}

.welcome-hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(20, 15, 13, 0.74) 0%, rgba(20, 15, 13, 0.22) 55%, rgba(20, 15, 13, 0.06) 100%);
