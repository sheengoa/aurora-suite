<!--pages/myorder/myorder.wxml-->
<view class="page">
  <view class="orders-body">
    <view class="segment">
      <view
        class="segment-item {{currentTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="index"
        bindtap="switchTab"
        data-index="{{index}}"
        hover-class="soft-control-pressed">
        {{item}}
      </view>
    </view>

    <view class="order-list">
      <view class="order-card" wx:for="{{orderList}}" wx:key="_id">
        <view class="order-head">
          <text class="order-id">{{item.displayOrderLabel}} {{item.displayOrderNo}}</text>
          <view class="order-status {{item.statusClass}}">
            <text class="order-status-icon {{item.statusIcon}}"></text>
            <text>{{item.statusText}}</text>
          </view>
        </view>

        <view class="order-products">
          <image wx:if="{{item.primaryGoodsImage}}" class="order-product-image" src="{{item.primaryGoodsImage}}" mode="aspectFill"></image>
          <view wx:else class="order-product-icon {{item.type === 'recharge' ? 'recharge-icon' : ''}}">
            <text class="{{item.type === 'recharge' ? 'cuIcon-rechargefill' : 'cuIcon-shopfill'}}"></text>
          </view>
          <view class="order-product-copy">
            <text class="order-product-title">{{item.goodsSummary}}</text>
            <text class="order-product-meta">{{item.goodsMeta}}</text>
          </view>
        </view>

        <view class="order-foot">
          <view class="order-total">
            <text>实付 </text>
            <text class="order-total-value">¥{{item.amountText}}</text>
          </view>
          <view class="mini-btn" bindtap="viewOrderDetail" data-order="{{item}}" hover-class="soft-control-pressed">
            {{item.type === 'recharge' ? '查看记录' : '查看详情'}}
          </view>
        </view>
      </view>

      <van-empty wx:if="{{orderList.length === 0}}" description="暂无订单" />
    </view>
  </view>
</view>
