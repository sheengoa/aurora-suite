page {
  min-height: 100%;
  background: #f9f9f9;
  color: #20242a;
}

.page,
.page view,
.page text {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  background: #f9f9f9;
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 24rpx);
}

.orders-body {
  padding: 20rpx 24rpx 34rpx;
}

.segment {
  height: 100rpx;
  padding: 6rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4rpx;
  background: #e9edf3;
  border-radius: 24rpx;
}

.segment-item {
  min-width: 0;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a8491;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 20rpx;
  transition: color 180ms ease, background 180ms ease, transform 160ms ease;
}

.segment-item.active {
  color: #20242a;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(37, 45, 58, 0.12);
}

.order-list {
  margin-top: 24rpx;
}

.order-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(32, 36, 42, 0.04);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(27, 36, 48, 0.07);
}

.order-head,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-id {
  min-width: 0;
  overflow: hidden;
  color: #20242a;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  color: #b16a0e;
  font-size: 23rpx;
  font-weight: 700;
}

.order-status.success {
  color: #168576;
}

.order-status.cancelled {
  color: #8f817c;
}

.order-status.pending-payment {
  color: #8c271e;
}

.order-status-icon {
  font-size: 27rpx;
}

.order-products {
  min-width: 0;
  margin-top: 25rpx;
  padding-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #e8eaee;
}

.order-product-image,
.order-product-icon {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
}

.order-product-image {
  display: block;
  background: #f0f2f5;
}

.order-product-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8c271e;
  font-size: 38rpx;
  background: #f7ebe8;
}

.order-product-icon.recharge-icon {
  color: #8c271e;
}

.order-product-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-product-title,
.order-product-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-product-title {
  color: #20242a;
  font-size: 27rpx;
  font-weight: 800;
}

.order-product-meta {
  color: #8f96a1;
  font-size: 23rpx;
}

.order-foot {
  min-height: 76rpx;
  padding-top: 20rpx;
}

.order-total {
  display: flex;
  align-items: baseline;
  color: #30353d;
  font-size: 25rpx;
}

.order-total-value {
  margin-left: 5rpx;
  color: #20242a;
  font-size: 31rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.mini-btn {
  min-width: 146rpx;
  height: 76rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #c94a3c;
  font-size: 24rpx;
  font-weight: 750;
  border: 1rpx solid #efb2a9;
  border-radius: 20rpx;
  transition: opacity 160ms ease, transform 160ms ease;
}

.order-card-actions {
  padding-top: 16rpx;
  border-top: 1rpx solid #ebe8e6;
}

.order-pay-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 750;
  background: #8c271e;
  border-radius: var(--control-radius);
}

.soft-control-pressed {
  opacity: 0.72;
  transform: scale(0.98);
}

van-empty {
  display: block;
  margin-top: 80rpx;
}

.orders-state {
  min-height: 420rpx;
  padding: 72rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.orders-state-icon {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8c271e;
  background: #f7ebe8;
  border-radius: 24rpx;
  font-size: 46rpx;
}

.orders-state-title {
  margin-top: 24rpx;
  color: #1a1c1c;
  font-size: 30rpx;
  font-weight: 800;
}

.orders-state-copy {
  margin-top: 10rpx;
  color: #656461;
  font-size: 24rpx;
}

.orders-retry {
  min-width: 200rpx;
  min-height: 88rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #8c271e;
  border-radius: var(--control-radius);
  font-size: 26rpx;
  font-weight: 750;
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(26, 28, 28, 0.56);
  animation: detail-mask-in 200ms ease-out both;
}

.detail-sheet {
  width: 100%;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -24rpx 72rpx rgba(26, 28, 28, 0.2);
  animation: detail-sheet-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.detail-header {
  min-height: 112rpx;
  padding: 16rpx 16rpx 16rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
  border-bottom: 1rpx solid #ebe8e6;
}

.detail-heading {
  min-width: 0;
}

.detail-title {
  color: #1a1c1c;
  font-size: 32rpx;
  font-weight: 800;
}

.detail-order-no {
  margin-top: 6rpx;
  overflow: hidden;
  color: #656461;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-close {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #656461;
  border-radius: 50%;
  font-size: 30rpx;
}

.detail-scroll {
  min-height: 0;
  flex: 1;
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.detail-status-row {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: #fcf5f3;
  border-radius: 24rpx;
}

.detail-status-copy {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-status-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #a66a23;
  background: #fff5e7;
  border-radius: 18rpx;
  font-size: 32rpx;
}

.detail-status-icon.success {
  color: #287b61;
  background: #edf7f3;
}

.detail-status-icon.cancelled {
  color: #8f817c;
  background: #f2efed;
}

.detail-status-title {
  color: #1a1c1c;
  font-size: 28rpx;
  font-weight: 750;
}

.detail-status-time {
  margin-top: 6rpx;
  color: #656461;
  font-size: 21rpx;
}

.detail-paid {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #656461;
  font-size: 21rpx;
}

.detail-paid-value {
  margin-top: 4rpx;
  color: #8c271e;
  font-size: 34rpx;
  font-weight: 850;
}

.detail-section {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #ebe8e6;
  border-radius: 24rpx;
}

.detail-section-title {
  margin-bottom: 16rpx;
  color: #1a1c1c;
  font-size: 27rpx;
  font-weight: 800;
}

.detail-goods-item {
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #ebe8e6;
}

.detail-goods-main {
  min-width: 0;
  flex: 1;
}

.detail-goods-name {
  color: #1a1c1c;
  font-size: 26rpx;
  font-weight: 700;
  overflow-wrap: break-word;
}

.detail-goods-sku,
.detail-goods-tags,
.detail-goods-meta {
  margin-top: 6rpx;
  color: #656461;
  font-size: 22rpx;
  line-height: 1.45;
  overflow-wrap: break-word;
}

.detail-goods-subtotal {
  flex-shrink: 0;
  color: #1a1c1c;
  font-size: 25rpx;
  font-weight: 750;
}

.detail-data-row {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #656461;
  font-size: 24rpx;
}

.detail-data-row text:last-child {
  min-width: 0;
  color: #1a1c1c;
  text-align: right;
  overflow-wrap: break-word;
}

.detail-data-row.total {
  margin-top: 10rpx;
  padding-top: 16rpx;
  color: #1a1c1c;
  border-top: 1rpx solid #ebe8e6;
  font-weight: 800;
}

.detail-data-row.total text:last-child {
  color: #8c271e;
  font-size: 30rpx;
}

.detail-remark {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #ebe8e6;
}

.detail-remark-label {
  color: #656461;
  font-size: 23rpx;
}

.detail-remark-value {
  margin-top: 8rpx;
  color: #1a1c1c;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: break-word;
  white-space: pre-wrap;
}

.detail-refund {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  color: #8c271e;
  font-size: 24rpx;
  line-height: 1.5;
  background: #f7ebe8;
  border-radius: 16rpx;
}

.detail-footer {
  position: relative;
  z-index: 1;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
  background: #ffffff;
  border-top: 1rpx solid #ebe8e6;
}

.detail-cancel,
.detail-pay,
.detail-done {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: var(--control-radius);
  font-size: 27rpx;
  font-weight: 750;
}

.detail-cancel {
  color: #8c271e;
  background: #f7ebe8;
  border: 1rpx solid rgba(140, 39, 30, 0.14);
}

.detail-done {
  color: #ffffff;
  background: #8c271e;
  box-shadow: 0 10rpx 22rpx rgba(140, 39, 30, 0.18);
}

.detail-pay {
  color: #ffffff;
  background: #8c271e;
}

.detail-cancel.disabled {
  opacity: 0.48;
  pointer-events: none;
}

@keyframes detail-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes detail-sheet-in {
  from { transform: translateY(36rpx); }
  to { transform: translateY(0); }
}

/* 原型统一收束：订单筛选与操作 */
.segment {
  border-radius: var(--control-radius);
}

.segment-item {
  border-radius: 22rpx;
}

.order-card {
  border-radius: 24rpx;
}

.mini-btn {
  min-height: 88rpx;
  border-radius: var(--control-radius);
}
