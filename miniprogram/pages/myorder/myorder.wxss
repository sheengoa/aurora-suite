page {
  min-height: 100%;
  background: #f6f7f9;
  color: #20242a;
}

.page,
.page view,
.page text {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 24rpx);
}

.orders-body {
  padding: 20rpx 24rpx 34rpx;
}

.segment {
  height: 88rpx;
  padding: 6rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4rpx;
  background: #e9edf3;
  border-radius: 24rpx;
}

.segment-item {
  min-width: 0;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a8491;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 20rpx;
  transition: color 180ms ease, background 180ms ease, transform 160ms ease;
}

.segment-item.active {
  color: #20242a;
  background: #ffffff;
  box-shadow: 0 6rpx 14rpx rgba(37, 45, 58, 0.12);
}

.order-list {
  margin-top: 24rpx;
}

.order-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(32, 36, 42, 0.04);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(27, 36, 48, 0.07);
}

.order-head,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.order-id {
  min-width: 0;
  overflow: hidden;
  color: #20242a;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  color: #b16a0e;
  font-size: 23rpx;
  font-weight: 700;
}

.order-status.success {
  color: #168576;
}

.order-status-icon {
  font-size: 27rpx;
}

.order-products {
  min-width: 0;
  margin-top: 25rpx;
  padding-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #e8eaee;
}

.order-product-image,
.order-product-icon {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
}

.order-product-image {
  display: block;
  background: #f0f2f5;
}

.order-product-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d94335;
  font-size: 38rpx;
  background: #fff0ed;
}

.order-product-icon.recharge-icon {
  color: #d94335;
}

.order-product-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.order-product-title,
.order-product-meta {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-product-title {
  color: #20242a;
  font-size: 27rpx;
  font-weight: 800;
}

.order-product-meta {
  color: #8f96a1;
  font-size: 23rpx;
}

.order-foot {
  min-height: 76rpx;
  padding-top: 20rpx;
}

.order-total {
  display: flex;
  align-items: baseline;
  color: #30353d;
  font-size: 25rpx;
}

.order-total-value {
  margin-left: 5rpx;
  color: #20242a;
  font-size: 31rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
}

.mini-btn {
  min-width: 146rpx;
  height: 76rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #c94a3c;
  font-size: 24rpx;
  font-weight: 750;
  border: 1rpx solid #efb2a9;
  border-radius: 20rpx;
  transition: opacity 160ms ease, transform 160ms ease;
}

.soft-control-pressed {
  opacity: 0.72;
  transform: scale(0.98);
}

van-empty {
  display: block;
  margin-top: 80rpx;
}

/* 原型统一收束：订单筛选与操作 */
.segment {
  border-radius: var(--control-radius);
}

.segment-item {
  border-radius: 22rpx;
}

.order-card {
  border-radius: 24rpx;
}

.mini-btn {
  min-height: 88rpx;
  border-radius: var(--control-radius);
}
