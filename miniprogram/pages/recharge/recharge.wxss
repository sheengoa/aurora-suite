page {
  min-height: 100%;
  background: #f4f5f7;
  color: #29282a;
}

.page,
.page view,
.page text {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
  background: #f4f5f7;
}

.campaign-hero {
  position: relative;
  padding: 26rpx 24rpx 30rpx;
  overflow: hidden;
  background: #c93b32;
}

.campaign-hero::after {
  content: "";
  position: absolute;
  top: 0;
  right: -120rpx;
  width: 460rpx;
  height: 100%;
  opacity: 0.12;
  background: repeating-linear-gradient(
    135deg,
    #ffffff 0,
    #ffffff 2rpx,
    transparent 2rpx,
    transparent 24rpx
  );
}

.hero-kicker {
  position: relative;
  z-index: 1;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-kicker .cuIcon-crown {
  font-size: 26rpx;
}

.merchant-pass {
  position: relative;
  z-index: 1;
  min-height: 146rpx;
  padding: 26rpx 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.76);
  border-radius: 16rpx;
  box-shadow: 0 18rpx 40rpx rgba(103, 25, 20, 0.24);
}

.merchant-pass::after {
  content: "";
  position: absolute;
  top: -60rpx;
  right: 150rpx;
  width: 200rpx;
  height: 300rpx;
  opacity: 0.07;
  transform: rotate(24deg);
  background: repeating-linear-gradient(
    90deg,
    #d94335 0,
    #d94335 2rpx,
    transparent 2rpx,
    transparent 12rpx
  );
}

.merchant-mark {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 37rpx;
  background: #d94335;
  border-radius: 12rpx;
}

.merchant-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.merchant-name,
.merchant-caption {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-name {
  color: #2a292b;
  font-size: 31rpx;
  font-weight: 800;
}

.merchant-caption {
  margin-top: 9rpx;
  color: #85858a;
  font-size: 22rpx;
  font-weight: 600;
}

.balance-panel {
  position: relative;
  z-index: 1;
  max-width: 236rpx;
  padding-left: 20rpx;
  flex-shrink: 0;
  text-align: right;
  border-left: 1rpx solid #efd9d6;
}

.balance-label {
  color: #8b898e;
  font-size: 21rpx;
  font-weight: 600;
}

.balance-amount {
  margin-top: 5rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  color: #d94335;
  line-height: 1;
}

.balance-symbol {
  margin-right: 4rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.balance-num {
  max-width: 190rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trust-line {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 1.4;
}

.trust-line .cuIcon-safe {
  flex-shrink: 0;
  font-size: 24rpx;
}

.recharge-section {
  padding: 30rpx 24rpx 34rpx;
  background: #ffffff;
}

.section-heading {
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 11rpx;
}

.section-icon {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 25rpx;
  background: #d94335;
  border-radius: 10rpx;
}

.section-title {
  color: #29282a;
  font-size: 32rpx;
  font-weight: 800;
}

.section-subtitle {
  flex-shrink: 0;
  color: #8d8c91;
  font-size: 22rpx;
}

.recharge-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.recharge-item {
  position: relative;
  width: 100%;
  min-width: 0;
  min-height: 296rpx;
  padding: 38rpx 22rpx 22rpx;
  overflow: hidden;
  background: #ffffff;
  border: 2rpx solid #e8e8eb;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 24rpx rgba(48, 39, 39, 0.06);
}

.recharge-item.selected {
  background: #fff3f1;
  border-color: #d94335;
  box-shadow: 0 14rpx 30rpx rgba(217, 67, 53, 0.16);
}

.recommend-badge {
  position: absolute;
  top: 0;
  left: 0;
  min-height: 42rpx;
  padding: 0 15rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 750;
  background: #d94335;
  border-radius: 0 0 10rpx 0;
}

.selected-mark {
  position: absolute;
  top: 0;
  right: 0;
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  background: #d94335;
  border-radius: 0 0 0 12rpx;
}

.plan-label {
  color: #8a898e;
  font-size: 21rpx;
  font-weight: 650;
}

.recharge-amount {
  min-width: 0;
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  color: #2d2929;
  line-height: 1;
}

.amount-symbol {
  margin-right: 4rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.amount-num {
  max-width: 220rpx;
  overflow: hidden;
  font-size: 48rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gift-line {
  min-height: 42rpx;
  margin-top: 15rpx;
  padding: 0 13rpx;
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  color: #c6372e;
  font-size: 22rpx;
  font-weight: 700;
  background: #fff0ed;
  border-radius: 8rpx;
}

.gift-line.no-gift {
  color: #77767b;
  background: #f2f2f4;
}

.gift-line text:first-child {
  font-size: 21rpx;
}

.plan-divider {
  margin: 20rpx 0 15rpx;
  border-top: 1rpx dashed #dfd8cf;
}

.arrival-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  color: #88878c;
  font-size: 21rpx;
}

.arrival-value {
  min-width: 0;
  overflow: hidden;
  color: #d94335;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recharge-desc {
  margin-top: 9rpx;
  overflow: hidden;
  color: #96959a;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-pressed,
.control-pressed {
  opacity: 0.72;
}

.rules-section {
  margin-top: 16rpx;
  padding: 30rpx 24rpx 34rpx;
  background: #ffffff;
}

.rules-heading {
  padding-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ececef;
}

.rules-title {
  display: flex;
  align-items: center;
  gap: 11rpx;
  color: #29282a;
  font-size: 30rpx;
  font-weight: 800;
}

.rules-title .cuIcon-notice {
  color: #d94335;
  font-size: 29rpx;
}

.rules-badge {
  min-height: 42rpx;
  padding: 0 13rpx;
  display: flex;
  align-items: center;
  color: #b6372f;
  font-size: 20rpx;
  font-weight: 700;
  background: #fff0ed;
  border-radius: 8rpx;
}

.rule-item {
  padding-top: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
}

.rule-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #d94335;
  font-size: 28rpx;
  background: #fff0ed;
  border-radius: 12rpx;
}

.rule-copy {
  min-width: 0;
  flex: 1;
}

.rule-title {
  color: #3a393c;
  font-size: 25rpx;
  font-weight: 700;
}

.rule-desc {
  margin-top: 6rpx;
  color: #838288;
  font-size: 23rpx;
  line-height: 1.55;
}

.checkout-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  min-height: 136rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border-top: 1rpx solid #e7e7ea;
  box-shadow: 0 -12rpx 34rpx rgba(47, 39, 39, 0.12);
}

.checkout-summary {
  position: relative;
  min-width: 0;
  flex: 1;
}

.checkout-label {
  color: #929196;
  font-size: 20rpx;
}

.checkout-price {
  margin-top: 3rpx;
  display: flex;
  align-items: baseline;
  color: #d94335;
  line-height: 1;
}

.checkout-symbol {
  margin-right: 3rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.checkout-amount {
  max-width: 210rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-arrival {
  position: absolute;
  right: 0;
  bottom: 2rpx;
  max-width: 170rpx;
  overflow: hidden;
  color: #b6372f;
  font-size: 20rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-btn {
  width: 284rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 800;
  background: #d94335;
  border-radius: 12rpx;
  box-shadow: 0 10rpx 22rpx rgba(217, 67, 53, 0.24);
}

.checkout-btn .cuIcon-right {
  font-size: 22rpx;
}
