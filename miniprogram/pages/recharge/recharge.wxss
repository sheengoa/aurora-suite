page {
  min-height: 100%;
  background: #f9f9f9;
  color: #29282a;
}

.page,
.page view,
.page text {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
  background: #f9f9f9;
}

.campaign-hero {
  position: relative;
  padding: 20rpx 24rpx 26rpx;
  overflow: hidden;
  background: #8c271e;
}

.merchant-pass {
  position: relative;
  z-index: 1;
  min-height: 128rpx;
  padding: 18rpx 20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border-radius: var(--card-radius);
  box-shadow: 0 12rpx 30rpx rgba(91, 25, 21, 0.12);
}

.merchant-ornament {
  position: absolute;
  top: -92rpx;
  right: 168rpx;
  width: 252rpx;
  height: 312rpx;
  transform: rotate(-18deg);
}

.merchant-ornament-arc {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 2rpx solid rgba(140, 39, 30, 0.12);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.ornament-arc-one {
  width: 252rpx;
  height: 312rpx;
}

.ornament-arc-two {
  width: 184rpx;
  height: 238rpx;
  border-color: rgba(140, 39, 30, 0.1);
}

.ornament-arc-three {
  width: 120rpx;
  height: 166rpx;
  border-color: rgba(140, 39, 30, 0.08);
}

.merchant-mark {
  position: relative;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 37rpx;
  background: #8c271e;
  border-radius: var(--field-radius);
}

.merchant-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}

.merchant-name,
.merchant-caption {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.merchant-name {
  color: #22252b;
  font-size: 31rpx;
  font-weight: 800;
}

.merchant-caption {
  margin-top: 9rpx;
  color: #69707d;
  font-size: 22rpx;
  font-weight: 600;
}

.balance-panel {
  position: relative;
  z-index: 1;
  max-width: 236rpx;
  padding-left: 18rpx;
  flex-shrink: 0;
  text-align: right;
  border-left: 1rpx solid #ebeef3;
}

.balance-label {
  color: #9aa1ad;
  font-size: 21rpx;
  font-weight: 600;
}

.balance-amount {
  margin-top: 5rpx;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  color: #8c271e;
  line-height: 1;
}

.balance-symbol {
  margin-right: 4rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.balance-num {
  max-width: 190rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trust-line {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 1.4;
}

.trust-line .cuIcon-safe {
  flex-shrink: 0;
  font-size: 24rpx;
}

.recharge-section {
  padding: 28rpx 24rpx 34rpx;
  background: #ffffff;
}

.section-heading {
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  color: #29282a;
  font-size: 32rpx;
  font-weight: 800;
}

.section-subtitle {
  flex-shrink: 0;
  color: #8d8c91;
  font-size: 22rpx;
}

.recharge-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.recharge-item {
  position: relative;
  width: 100%;
  min-width: 0;
  min-height: 252rpx;
  padding: 32rpx 20rpx 18rpx;
  overflow: hidden;
  background: #ffffff;
  border: 2rpx solid #dfe2e7;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 24rpx rgba(48, 39, 39, 0.06);
}

.recharge-item.selected {
  background: #fff3f1;
  border-color: #8c271e;
  box-shadow: 0 14rpx 30rpx rgba(140, 39, 30, 0.16);
}

.selected-mark {
  position: absolute;
  top: 0;
  right: 0;
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 22rpx;
  background: #8c271e;
  border-radius: 0 0 0 16rpx;
}

.plan-label {
  color: #8a898e;
  font-size: 21rpx;
  font-weight: 650;
}

.recharge-amount {
  min-width: 0;
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  color: #2d2929;
  line-height: 1;
}

.amount-symbol {
  margin-right: 4rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.amount-num {
  max-width: 220rpx;
  overflow: hidden;
  font-size: 48rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gift-line {
  min-height: 34rpx;
  margin-top: 13rpx;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  color: #168576;
  font-size: 22rpx;
  font-weight: 700;
  background: transparent;
}

.gift-line.no-gift {
  color: #77767b;
  background: transparent;
}

.gift-line text:first-child {
  font-size: 21rpx;
}

.plan-divider {
  margin: 14rpx 0 12rpx;
  border-top: 1rpx solid #e8eaee;
}

.arrival-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  color: #88878c;
  font-size: 21rpx;
}

.arrival-value {
  min-width: 0;
  overflow: hidden;
  color: #8c271e;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recharge-desc {
  margin-top: 9rpx;
  overflow: hidden;
  color: #96959a;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-pressed,
.control-pressed {
  opacity: 0.72;
}

.rules-section {
  margin-top: 16rpx;
  padding: 30rpx 24rpx 34rpx;
  background: #ffffff;
}

.rules-heading {
  padding-bottom: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #ececef;
}

.rules-title {
  display: flex;
  align-items: center;
  gap: 11rpx;
  color: #29282a;
  font-size: 30rpx;
  font-weight: 800;
}

.rules-title .cuIcon-notice {
  color: #8c271e;
  font-size: 29rpx;
}

.rules-badge {
  min-height: 42rpx;
  padding: 0 13rpx;
  display: flex;
  align-items: center;
  color: #b6372f;
  font-size: 20rpx;
  font-weight: 700;
  background: #f7ebe8;
  border-radius: 8rpx;
}

.rule-item {
  padding-top: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 17rpx;
}

.rule-icon {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #8c271e;
  font-size: 28rpx;
  background: #f7ebe8;
  border-radius: 12rpx;
}

.rule-copy {
  min-width: 0;
  flex: 1;
}

.rule-title {
  color: #3a393c;
  font-size: 25rpx;
  font-weight: 700;
}

.rule-desc {
  margin-top: 6rpx;
  color: #838288;
  font-size: 23rpx;
  line-height: 1.55;
}

.checkout-wrapper {
  position: fixed;
  right: 24rpx;
  bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 16rpx);
  left: 24rpx;
  z-index: 30;
}

.merchant-ornament { display: none; }

.checkout-bar {
  padding: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  background: #ffffff;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
}

.checkout-left {
  min-width: 0;
  display: flex;
  align-items: center;
  flex: 1;
}

.checkout-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  color: #8c271e;
  font-size: 42rpx;
  border-radius: 30rpx;
  background: #f7ebe8;
}

.checkout-summary {
  min-width: 0;
  flex: 1;
}

.checkout-price {
  display: flex;
  align-items: baseline;
  color: #8c271e;
  line-height: 1;
}

.checkout-symbol {
  margin-right: 3rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.checkout-amount {
  max-width: 220rpx;
  overflow: hidden;
  font-size: 38rpx;
  font-weight: 850;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-arrival {
  margin-top: 4rpx;
  max-width: 220rpx;
  overflow: hidden;
  color: #85858a;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.checkout-right {
  flex-shrink: 0;
}

.checkout-btn {
  min-width: 240rpx;
  height: 88rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 800;
  background: #8c271e;
  border-radius: 26rpx;
  transition: transform 160ms ease, opacity 160ms ease;
}

.checkout-btn:active {
  transform: scale(0.97);
}

.checkout-btn .cuIcon-right {
  font-size: 22rpx;
}

/* 原型统一收束：储值方案与点餐操作栏同构 */
.page {
  padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom) + 160rpx);
}

.recharge-item {
  border-radius: 28rpx;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
}

.plan-pressed {
  transform: scale(0.98);
}

.rules-badge,
.rule-icon {
  border-radius: var(--field-radius);
}

.checkout-bar {
  min-height: 112rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.06);
  border-radius: var(--floating-radius);
  box-shadow: 0 18rpx 54rpx rgba(27, 36, 48, 0.18);
}

.checkout-btn {
  border-radius: var(--control-radius);
}
