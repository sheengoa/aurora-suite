/* pages/settle/settle.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  box-sizing: border-box;
  padding-bottom: calc(164rpx + env(safe-area-inset-bottom));
}

.section {
  background: white;
  margin: 20rpx 20rpx 0;
  padding: 30rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.section:first-child {
  margin-top: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
  letter-spacing: 0;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 20rpx;
}

.section-title-wrapper .section-title {
  padding: 0;
  margin-bottom: 0;
}

.edit-order-btn {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #d94335;
  border: 2rpx solid #d94335;
  border-radius: 8rpx;
  background: white;
}

/* 订单类型选择 */
.order-type-list {
  display: flex;
  padding: 0 30rpx;
  gap: 20rpx;
}

.order-type-item {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
  cursor: pointer;
  user-select: none;
}

.remark-input {
  width: auto;
  display: block;
  min-height: 150rpx;
  margin: 0 30rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}

.order-type-item.active {
  color: #d94335;
  background: rgba(229, 77, 66, 0.1);
  border-color: #d94335;
  font-weight: 600;
}

/* 桌码显示 */
.table-code-wrapper {
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.table-code-display {
  flex: 1;
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.table-code-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.table-code-bold {
  font-weight: 700;
  font-size: 36rpx;
  color: #22252b;
}

.table-code-empty {
  color: #d94335;
  font-size: 30rpx;
  font-weight: 600;
}

.table-code-actions {
  margin-left: 20rpx;
}

.change-table-btn {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  color: #d94335;
  border: 2rpx solid #d94335;
  border-radius: 8rpx;
  background: white;
  cursor: pointer;
  user-select: none;
}

/* 商品列表 */
.goods-list {
  padding: 0 30rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background-color 0.2s;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-item:active {
  background-color: #fafafa;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5f5f5;
  overflow: hidden;
}

.goods-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 22rpx;
}

.goods-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 140rpx;
}

.goods-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.goods-sku {
  font-size: 24rpx;
  color: #38b2ac;
  margin-bottom: 8rpx;
}

.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.goods-price-count {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.goods-price {
  font-size: 26rpx;
  color: #d94335;
  font-weight: bold;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.goods-subtotal {
  font-size: 32rpx;
  color: #d94335;
  font-weight: 600;
  min-width: 120rpx;
  text-align: right;
}

/* 价格信息 */
.price-info {
  padding: 0 30rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
}

.price-item.total {
  font-size: 34rpx;
  font-weight: 600;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 24rpx;
  margin-top: 12rpx;
}

.price-label {
  color: #666;
}

.price-value {
  color: #d94335;
  font-weight: 600;
  font-size: 30rpx;
}

.price-item.total .price-value {
  font-size: 36rpx;
}

/* 支付方式卡片 */
.pay-method-list {
  padding: 0 30rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.payment-section {
  margin-bottom: 24rpx;
}

.pay-method-item {
  flex: 1;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  padding: 20rpx;
  transition: all 0.3s;
  min-width: 0;
}

.pay-method-item.active {
  background: rgba(229, 77, 66, 0.08);
  border-color: #d94335;
}

.pay-method-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.pay-method-left {
  width: 100%;
}

.pay-method-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.pay-method-item.active .pay-method-title {
  color: #d94335;
  font-weight: 600;
}

.pay-method-desc {
  font-size: 22rpx;
  color: #999;
  line-height: 1.4;
}

.pay-method-item.active .pay-method-desc {
  color: #666;
}

.pay-method-radio {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 12rpx;
}

.pay-method-radio.checked {
  border-color: #d94335;
  background: #d94335;
}

.radio-dot {
  width: 16rpx;
  height: 16rpx;
  background: white;
  border-radius: 50%;
}

/* 底部提交区域 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 24rpx 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.footer-price {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.footer-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}

.footer-price-num {
  font-size: 44rpx;
  color: #d94335;
  font-weight: 600;
  letter-spacing: 0;
}

.submit-btn {
  width: 240rpx;
  min-width: 240rpx;
  max-width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  background-color: #d94335;
  color: white;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(229, 77, 66, 0.3);
  transition: all 0.3s;
}

.submit-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.submit-btn.disabled {
  background-color: #ccc;
  color: #999;
  box-shadow: none;
  opacity: 0.6;
}

.submit-btn.disabled:active {
  opacity: 0.6;
  transform: none;
}

/* 高级版视觉覆盖 */
.page {
  padding-top: 20rpx;
  background: linear-gradient(180deg, #fff7f3 0%, #f6f7f9 260rpx, #f6f7f9 100%);
}

.section {
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.section-title {
  color: #22252b;
  letter-spacing: 0;
}

.edit-order-btn,
.change-table-btn {
  color: #d94335;
  border-color: rgba(217, 67, 53, 0.32);
  background: #fff4f0;
  border-radius: 999rpx;
}

.order-type-item {
  background: #f7f8fa;
  border-color: #ebeef3;
  color: #69707d;
}

.order-type-item.active {
  color: #d94335;
  background: #fff4f0;
  border-color: rgba(217, 67, 53, 0.34);
  box-shadow: 0 8rpx 18rpx rgba(217, 67, 53, 0.1);
}

.remark-input,
.pay-method-item {
  background: #fbfcfd;
  border: 1rpx solid #ebeef3;
}

.table-code-bold,
.goods-name,
.pay-method-title {
  color: #22252b;
}

.footer-label,
.pay-method-desc,
.goods-count {
  color: #9aa1ad;
}

.goods-image {
  border-radius: 14rpx;
  background: #f0f2f5;
}

.goods-sku {
  color: #1f9d8a;
}

.goods-price,
.goods-subtotal,
.footer-price-num,
.price-value {
  color: #d94335;
}

.pay-method-item.active {
  background: #fff4f0;
  border-color: rgba(217, 67, 53, 0.34);
}

.pay-method-item.active .pay-method-title {
  color: #d94335;
}

.pay-method-radio.checked {
  border-color: #d94335;
  background: #d94335;
}

.footer {
  border-top-color: #ebeef3;
  box-shadow: 0 -12rpx 34rpx rgba(27, 36, 48, 0.1);
}

.submit-btn {
  background: linear-gradient(135deg, #b9322a 0%, #d94335 58%, #f36a5d 100%);
  box-shadow: 0 12rpx 26rpx rgba(217, 67, 53, 0.22);
}
