/* pages/myhome/myhome.wxss */
.myhome-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fff7f3 0%, #f6f7f9 360rpx, #f6f7f9 100%);
}

.member-hero {
  position: relative;
  min-height: 430rpx;
  padding: 34rpx;
  border-radius: 20rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(135deg, #9f2c25 0%, #d94335 58%, #f36a5d 100%);
  box-shadow: 0 22rpx 50rpx rgba(217, 67, 53, 0.24);
}

.hero-bg-mark {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero-bg-mark.one {
  top: -112rpx;
  right: -110rpx;
  width: 320rpx;
  height: 320rpx;
}

.hero-bg-mark.two {
  left: -130rpx;
  bottom: -170rpx;
  width: 360rpx;
  height: 360rpx;
  opacity: 0.72;
}

.hero-illustration {
  position: absolute;
  right: 12rpx;
  bottom: 42rpx;
  width: 230rpx;
  height: 230rpx;
  opacity: 0.14;
}

.member-profile,
.hero-metrics {
  position: relative;
  z-index: 1;
}

.member-profile {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  margin-right: 26rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  border: 5rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 14rpx 34rpx rgba(82, 20, 16, 0.22);
  flex-shrink: 0;
}

.profile-avatar image {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-kicker {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}

.profile-name {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 25rpx;
}

.profile-edit {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #d94335;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(82, 20, 16, 0.12);
  flex-shrink: 0;
}

.hero-metrics {
  display: flex;
  align-items: center;
  margin-top: 78rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.14);
}

.metric-item {
  flex: 1;
  min-width: 0;
}

.metric-divider {
  width: 1rpx;
  height: 58rpx;
  margin: 0 32rpx;
  background: rgba(255, 255, 255, 0.26);
}

.metric-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.metric-value {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1;
}

.metric-value.small {
  font-size: 30rpx;
}

.service-section {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.section-heading {
  position: relative;
  padding-left: 18rpx;
  color: #22252b;
  font-size: 30rpx;
  font-weight: 800;
}

.section-heading::before {
  content: '';
  position: absolute;
  left: 0;
  top: 7rpx;
  width: 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #d94335;
}

.service-grid {
  display: flex;
  margin-top: 24rpx;
}

.service-tile {
  flex: 1;
  min-width: 0;
  height: 184rpx;
  margin: 0 16rpx 0 0;
  padding: 22rpx 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8f9fb;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.service-tile:last-child {
  margin-right: 0;
}

button.service-tile {
  border: 0;
  line-height: 1.2;
}

button.service-tile::after {
  border: none;
}

.service-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.service-icon-wrap.red {
  background: #fff1ef;
}

.service-icon-wrap.amber {
  background: #fff7e8;
}

.service-icon-wrap image {
  width: 44rpx;
  height: 44rpx;
}

.service-title {
  color: #22252b;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.2;
}

.service-desc {
  margin-top: 8rpx;
  color: #9aa1ad;
  font-size: 22rpx;
  line-height: 1.2;
}

.admin-trigger {
  position: fixed;
  right: 0;
  bottom: 0;
  width: 200rpx;
  height: 200rpx;
  z-index: 10;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(19, 24, 33, 0.58);
  backdrop-filter: blur(8rpx);
}

.modal-dialog {
  width: 620rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 30rpx 90rpx rgba(19, 24, 33, 0.24);
}

.modal-title {
  padding: 42rpx 34rpx 22rpx;
  color: #22252b;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
}

.modal-content {
  padding: 20rpx 34rpx 38rpx;
}

.password-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 2rpx solid #e6e9ef;
  border-radius: 12rpx;
  background: #fbfcfd;
  font-size: 28rpx;
}

.password-hint {
  margin-top: 20rpx;
  color: #d94335;
  text-align: center;
  font-size: 24rpx;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #ebeef3;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.modal-btn.cancel {
  color: #9aa1ad;
  border-right: 2rpx solid #ebeef3;
}

.modal-btn.confirm {
  color: #d94335;
  font-weight: 800;
}

.version-info {
  padding: 34rpx 0 0;
  text-align: center;
}

.version-text {
  color: #b1b6bf;
  font-size: 24rpx;
}
