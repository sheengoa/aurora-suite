.share-action,
.buy-button,
.add-button,
.secondary-button,
.primary-button {
  padding: 0;
  margin: 0;
  border: 0;
  line-height: 1;
  background: transparent;
  appearance: none;
}

.share-action::after,
.buy-button::after,
.add-button::after,
.secondary-button::after,
.primary-button::after {
  border: 0;
}

.detail-page {
  position: relative;
  min-height: 100vh;
  background: #f6f7f9;
  color: #22252b;
}

.detail-navigation {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  pointer-events: none;
}

.detail-navbar {
  min-height: 44px;
  display: flex;
  align-items: center;
}

.detail-back {
  width: 88rpx;
  height: 88rpx;
  margin-left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(32, 35, 41, 0.08);
  border-radius: 50%;
  color: #202329;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 8rpx 24rpx rgba(22, 27, 34, 0.14);
  pointer-events: auto;
}

.detail-back-pressed {
  background: #f1f2f4;
}

.hero {
  position: relative;
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  background: #eceff2;
}

.hero-image,
.hero-swiper,
.hero-placeholder {
  width: 100%;
  height: 100%;
}

.hero-image:active {
  opacity: 0.92;
}

.hero-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #a2a8b1;
  font-size: 26rpx;
  background: #eef0f3;
}

.product-band,
.selection-band,
.detail-band {
  background: #ffffff;
}

.product-band {
  padding: 30rpx 32rpx;
  border-bottom: 14rpx solid #f6f7f9;
}

.product-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.category-label {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
}

.category-label {
  color: #9c6517;
  background: #fff7e8;
}

.product-name {
  min-width: 0;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #202329;
  word-break: break-all;
}

.product-description {
  margin-top: 20rpx;
  color: #777f8a;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.selection-band {
  padding: 0 32rpx;
}

.selection-section {
  padding: 34rpx 0;
  border-bottom: 1rpx solid #eceef1;
}

.selection-section:last-child {
  border-bottom: 0;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #25282e;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.required-mark {
  display: inline-flex;
  align-items: center;
  min-height: 32rpx;
  margin-left: 12rpx;
  padding: 0 10rpx;
  border-radius: 5rpx;
  color: #d94335;
  background: #fff1ee;
  font-size: 20rpx;
  font-weight: 500;
  vertical-align: 4rpx;
}

.section-hint {
  color: #a0a6b0;
  font-size: 23rpx;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.sku-option {
  position: relative;
  min-width: 0;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
  border: 2rpx solid #e4e7eb;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.sku-option.selected {
  border-color: #d94335;
  background: #fff6f3;
}

.option-check {
  position: absolute;
  top: 0;
  right: 0;
  width: 34rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 10rpx 0 10rpx;
  color: #ffffff;
  background: #d94335;
}

.sku-name {
  color: #30343a;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 600;
  text-align: center;
  word-break: break-all;
}

.sku-option.selected .sku-name {
  color: #b9322a;
}

.tag-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-option {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: 2rpx solid #e4e7eb;
  border-radius: 12rpx;
  color: #555c66;
  background: #ffffff;
  font-size: 26rpx;
}

.tag-option.selected {
  border-color: #d94335;
  color: #b9322a;
  background: #fff6f3;
  font-weight: 600;
}

.detail-band {
  margin-top: 14rpx;
  padding: 32rpx;
}

.detail-title {
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #eceef1;
  color: #25282e;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.stepper {
  display: grid;
  grid-template-columns: 72rpx 72rpx 72rpx;
  align-items: center;
}

.stepper-button {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dfe3e8;
  border-radius: 50%;
  color: #555c66;
  background: #f5f6f8;
  box-sizing: border-box;
}

.stepper-button.primary {
  border-color: #d94335;
  color: #ffffff;
  background: #d94335;
}

.stepper-button.disabled {
  color: #b8bdc5;
  background: #f4f5f6;
}

.quantity-value {
  min-width: 72rpx;
  text-align: center;
  color: #262a30;
  font-size: 30rpx;
  font-weight: 700;
}

.page-spacer {
  height: 270rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  min-height: 236rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  border-top: 1rpx solid rgba(34, 37, 43, 0.08);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 34rpx rgba(24, 30, 39, 0.08);
}

.action-summary {
  width: 100%;
  min-height: 72rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  column-gap: 24rpx;
  box-sizing: border-box;
}

.bottom-price {
  min-width: 0;
  display: flex;
  align-items: baseline;
  color: #d94335;
}

.bottom-price-label {
  margin-right: 12rpx;
  color: #8b929c;
  font-size: 23rpx;
}

.currency {
  margin-right: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.bottom-price-value {
  overflow: hidden;
  max-width: 280rpx;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-row {
  width: 100%;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.action-slot {
  position: relative;
  min-width: 0;
  height: 88rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.share-slot {
  width: 88rpx;
  min-width: 88rpx;
  flex-shrink: 0;
  border: 1rpx solid #e2e5e9;
  border-radius: 12rpx;
  background: #f7f8fa;
}

.buy-slot {
  width: 0;
  flex: 4 1 0%;
  margin-left: 16rpx;
  border-radius: 16rpx;
}

.add-slot {
  width: 0;
  flex: 5 1 0%;
  margin-left: 16rpx;
  border-radius: 16rpx;
}

.share-action,
.buy-button,
.add-button {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  max-width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.share-action {
  z-index: 2;
  color: transparent;
  background: transparent;
}

.share-visual {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: #30343a;
  font-size: 19rpx;
  line-height: 1.2;
  pointer-events: none;
}

.share-slot:active {
  background: #eef0f3;
}

.buy-button,
.add-button {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.buy-button {
  color: #c83b30;
  background: #fff1ee;
  border: 2rpx solid #f0b5ae;
}

.buy-button:active {
  background: #ffe7e2;
}

.add-button {
  color: #ffffff;
  background: #d94335;
  box-shadow: 0 10rpx 24rpx rgba(217, 67, 53, 0.24);
}

.add-button:active {
  transform: scale(0.99);
  background: #c63a2f;
}

.add-button.disabled {
  color: #9298a1;
  background: #e5e7ea;
  box-shadow: none;
}

.loading-state {
  min-height: 100vh;
  background: #ffffff;
}

.skeleton {
  background: linear-gradient(90deg, #eff1f3 25%, #f7f8f9 37%, #eff1f3 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

.skeleton-hero {
  width: 100%;
  height: 560rpx;
}

.loading-content {
  padding: 40rpx 32rpx;
}

.skeleton-title {
  width: 58%;
  height: 46rpx;
  border-radius: 8rpx;
}

.skeleton-line {
  width: 100%;
  height: 28rpx;
  margin-top: 28rpx;
  border-radius: 8rpx;
}

.skeleton-line.short {
  width: 72%;
  margin-top: 18rpx;
}

.error-state {
  min-height: 76vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
  color: #747b86;
}

.error-icon {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #d94335;
  background: #fff1ee;
}

.error-title {
  margin-top: 26rpx;
  color: #3d424a;
  font-size: 29rpx;
  font-weight: 600;
  text-align: center;
}

.error-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.secondary-button,
.primary-button {
  min-width: 190rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.secondary-button {
  border: 1rpx solid #d9dde2;
  color: #555c66;
  background: #ffffff;
}

.primary-button {
  color: #ffffff;
  background: #d94335;
}

.primary-button.compact {
  min-width: 180rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton {
    animation: none;
  }
}
