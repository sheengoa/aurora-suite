/* pages/admin/user/user.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  margin-bottom: 20rpx;
  gap: 15rpx;
}

.search-input {
  flex: 1;
  height: 70rpx;
  background: white;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.search-btn,
.clear-btn {
  padding: 0 30rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: white;
}

.search-btn {
  background: #8c271e;
}

.clear-btn {
  background: #999;
}

/* 用户列表 */
.user-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.user-item {
  padding: 30rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid #f5f5f5;
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.default-avatar {
  width: 100%;
  height: 100%;
  background: #fff3f0;
  color: #8c271e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
}

.member-badge {
  font-size: 28rpx;
  margin-left: 10rpx;
}

.user-detail {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.user-detail:last-child {
  margin-bottom: 0;
}

.user-arrow {
  font-size: 28rpx;
  color: #999;
}

.user-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-left: 20rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  white-space: nowrap;
  text-align: center;
}

.balance-btn {
  background: #38b2ac;
  color: white;
}

.empty-tip {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.modal-dialog {
  width: 600rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-title {
  padding: 40rpx 30rpx 20rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-content {
  padding: 20rpx 30rpx 40rpx;
}

.user-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.preview-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.preview-avatar image {
  width: 100%;
  height: 100%;
}

.preview-name {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 132rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #22252b;
  font-size: 27rpx;
  line-height: 1.5;
  background: #fbfcfd;
  border: 1rpx solid #e6e9ef;
  border-radius: var(--field-radius);
}

.balance-log-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #ebeef3;
}

.balance-log-title { color: #22252b; font-size: 26rpx; font-weight: 750; }
.balance-log-empty { padding: 24rpx 0; color: #9aa1ad; font-size: 24rpx; text-align: center; }
.balance-log-item { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid #f0f1f3; }
.balance-log-copy { min-width: 0; flex: 1; }
.balance-log-reason { color: #33363c; font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.balance-log-change { margin-top: 4rpx; color: #9aa1ad; font-size: 21rpx; }
.balance-log-amount { flex-shrink: 0; font-size: 25rpx; font-weight: 750; }
.balance-log-amount.income { color: #287b61; }
.balance-log-amount.expense { color: #8c271e; }
.modal-btn.disabled { opacity: 0.5; pointer-events: none; }

.balance-edit {
  display: flex;
  gap: 15rpx;
}

.balance-edit .form-input {
  flex: 1;
}

.recharge-btn {
  padding: 0 30rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #67c23a;
  color: white;
  border-radius: 10rpx;
  font-size: 26rpx;
  white-space: nowrap;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #e5e5e5;
}

.modal-btn {
  flex: 1;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.modal-btn.cancel {
  color: #999;
  border-right: 2rpx solid #e5e5e5;
}

.modal-btn.confirm {
  color: #8c271e;
  font-weight: bold;
}

/* 高级版视觉覆盖 */
.page {
  background: #f9f9f9;
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.search-bar {
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.search-input {
  height: 78rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.06);
  border-radius: 16rpx;
  box-shadow: 0 10rpx 26rpx rgba(27, 36, 48, 0.05);
}

.search-btn,
.clear-btn {
  height: 78rpx;
  border-radius: 16rpx;
}

.search-btn {
  background: #8c271e;
  box-shadow: 0 10rpx 22rpx rgba(140, 39, 30, 0.18);
}

.clear-btn {
  background: #eef1f5;
  color: #69707d;
}

.user-list {
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.user-item {
  border-bottom-color: #ebeef3;
}

.user-avatar {
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(27, 36, 48, 0.08);
}

.default-avatar {
  background: #fff4f0;
  color: #8c271e;
}

.user-name,
.preview-name {
  color: #22252b;
}

.user-detail {
  color: #9aa1ad;
}

.action-btn {
  border-radius: 999rpx;
}

.balance-btn {
  background: #edf8f5;
  color: #1f9d8a;
}

.modal-mask {
  background: rgba(19, 24, 33, 0.58);
  backdrop-filter: blur(8rpx);
}

.modal-dialog {
  width: 620rpx;
  border-radius: 16rpx;
  box-shadow: 0 30rpx 90rpx rgba(19, 24, 33, 0.24);
}

.modal-title {
  color: #22252b;
  font-size: 34rpx;
}

.user-preview {
  border-bottom-color: #ebeef3;
}

.form-label {
  color: #69707d;
  font-weight: 600;
}

.form-input {
  height: 88rpx;
  border-color: #e6e9ef;
  background: #fbfcfd;
}

.modal-footer {
  border-top-color: #ebeef3;
}

.modal-btn.cancel {
  border-right-color: #ebeef3;
}

.modal-btn.confirm {
  color: #8c271e;
}

/* 统一后台控件的尺寸与圆角 */
.search-input,
.search-btn,
.clear-btn {
  height: 88rpx;
  box-sizing: border-box;
  border-radius: var(--control-radius);
}

.search-btn,
.clear-btn {
  min-width: 132rpx;
}

.action-btn {
  min-height: 76rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--control-radius);
}

.modal-footer {
  gap: 14rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top-color: #ebeef3;
}

.modal-btn {
  height: 88rpx;
  border-radius: var(--control-radius);
}

.modal-btn.cancel {
  border-right: 0;
  color: #69707d;
  background: #f0f3f5;
}

.modal-btn.confirm {
  color: #ffffff;
  background: #8c271e;
  box-shadow: 0 10rpx 22rpx rgba(140, 39, 30, 0.18);
}

/* 原型统一收束：会员列表 */
.search-bar {
  align-items: stretch;
  gap: 12rpx;
}

.search-input,
.search-btn,
.clear-btn {
  min-height: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: var(--control-radius) !important;
}

.user-list {
  border-radius: 20rpx;
}

.user-item {
  min-height: 144rpx;
}

.user-actions {
  gap: 12rpx;
}

.action-btn,
.recharge-btn {
  min-height: 88rpx;
  min-width: 112rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--control-radius) !important;
}

.modal-dialog {
  border-radius: var(--modal-radius) !important;
}

.form-input {
  min-height: 88rpx;
  border-radius: var(--field-radius) !important;
}

.modal-btn {
  min-height: 88rpx;
  border-radius: var(--control-radius) !important;
}
