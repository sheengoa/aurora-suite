<!--pages/admin/admin.wxml-->
<view class="page">
  <view class="admin-top">
    <aurora-navbar id="page-navbar" title="管理员后台" variant="brand"></aurora-navbar>

    <view class="header">
      <view class="header-copy">
        <view class="header-kicker">
          <view class="header-kicker-dot"></view>
          <text>店铺运营</text>
        </view>
        <view class="header-title">小店工作台</view>
        <view class="header-subtitle">菜品、订单、会员与系统设置</view>
      </view>

      <view class="header-ticket" aria-hidden="true">
        <view class="ticket-top">
          <view class="ticket-mark"></view>
          <view class="ticket-line ticket-line-strong"></view>
        </view>
        <view class="ticket-line"></view>
        <view class="ticket-line ticket-line-short"></view>
        <view class="ticket-footer">
          <view class="ticket-status"></view>
          <view class="ticket-mini-line"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 管理菜单 -->
  <view class="menu-section">
    <view class="section-title">数据管理</view>
    <view class="menu-grid">
      <view class="admin-item" bindtap="goToDish" hover-class="admin-item-pressed" aria-role="button" aria-label="菜品管理">
        <view class="admin-icon tone-red cuIcon-shopfill" aria-hidden="true"></view>
        <text>菜品管理</text>
      </view>
      <view class="admin-item" bindtap="goToUser" hover-class="admin-item-pressed" aria-role="button" aria-label="会员管理">
        <view class="admin-icon tone-blue cuIcon-peoplefill" aria-hidden="true"></view>
        <text>会员管理</text>
      </view>
      <view class="admin-item" bindtap="goToOrder" hover-class="admin-item-pressed" aria-role="button" aria-label="订单管理">
        <view class="admin-icon tone-green cuIcon-formfill" aria-hidden="true"></view>
        <text>订单管理</text>
      </view>
      <view class="admin-item" bindtap="goToRechargeOptions" hover-class="admin-item-pressed" aria-role="button" aria-label="充值选项管理">
        <view class="admin-icon tone-orange cuIcon-moneybagfill" aria-hidden="true"></view>
        <text>充值选项管理</text>
      </view>
      <view class="admin-item" bindtap="goToTableCode" hover-class="admin-item-pressed" aria-role="button" aria-label="桌码管理">
        <view class="admin-icon tone-jade cuIcon-qr_code" aria-hidden="true"></view>
        <text>桌码管理</text>
      </view>
    </view>
  </view>

  <!-- 系统设置 -->
  <view class="menu-section">
    <view class="section-title">系统设置</view>
    <view class="menu-grid">
      <view class="admin-item" bindtap="goToShopSettings" hover-class="admin-item-pressed" aria-role="button" aria-label="店铺设置">
        <view class="admin-icon tone-red cuIcon-settingsfill" aria-hidden="true"></view>
        <text>店铺设置</text>
      </view>
      <view class="admin-item" bindtap="showChangePassword" hover-class="admin-item-pressed" aria-role="button" aria-label="修改密码">
        <view class="admin-icon tone-ink cuIcon-lock" aria-hidden="true"></view>
        <text>修改密码</text>
      </view>
      <view class="admin-item" bindtap="goToPrinter" hover-class="admin-item-pressed" aria-role="button" aria-label="打印机管理">
        <view class="admin-icon tone-amber cuIcon-file" aria-hidden="true"></view>
        <text>打印机管理</text>
      </view>
    </view>
  </view>

  <!-- 返回按钮 -->
  <view
    class="back-btn"
    bindtap="goBack"
    hover-class="soft-control-pressed"
    hover-stay-time="120"
    aria-role="button"
    aria-label="返回上一页">
    <text class="cuIcon-back back-icon" aria-hidden="true"></text>
    <text>返回</text>
  </view>

  <!-- 修改密码弹窗 -->
  <view class="modal-mask" wx:if="{{showPasswordModal}}" catchtap="closePasswordModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-title">修改密码</view>
      <view class="modal-content">
        <input 
          class="password-input" 
          type="password" 
          placeholder="请输入原密码" 
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
          aria-label="原密码"
        />
        <input 
          class="password-input" 
          type="password" 
          placeholder="请输入新密码（至少6位）" 
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
          aria-label="新密码"
        />
        <input 
          class="password-input" 
          type="password" 
          placeholder="请再次输入新密码" 
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
          aria-label="确认新密码"
        />
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closePasswordModal" hover-class="soft-control-pressed">取消</view>
        <view class="modal-btn confirm" bindtap="confirmChangePassword" hover-class="control-pressed">确认修改</view>
      </view>
    </view>
  </view>
</view>
