<view class="page">
  <view class="page-tools">
    <view class="tools-title">
      <text class="tools-icon cuIcon-scan"></text>
      <text>桌码列表</text>
    </view>
    <view class="add-btn" bindtap="showAddModal" hover-class="control-pressed">
      <text class="cuIcon-add"></text>
      <text>新建桌码</text>
    </view>
  </view>

  <view class="table-code-list">
    <view class="table-code-item" wx:for="{{tableCodeList}}" wx:key="_id">
      <view class="item-main">
        <view class="qr-shell" bindtap="previewPoster" data-item="{{item}}" hover-class="qr-pressed">
          <view class="qr-frame">
            <image
              wx:if="{{item.qrCodeUrl}}"
              class="qr-image"
              src="{{item.qrCodeUrl}}"
              mode="aspectFit"
              lazy-load="{{true}}"
            />
            <view wx:else class="qr-placeholder cuIcon-qrcode"></view>
            <view class="scan-corner corner-tl"></view>
            <view class="scan-corner corner-tr"></view>
            <view class="scan-corner corner-bl"></view>
            <view class="scan-corner corner-br"></view>
          </view>
        </view>

        <view class="code-info">
          <view class="code-heading">
            <view class="code-number">
              <text class="number-value">{{item.tableNumber}}</text>
              <text class="number-unit">号桌</text>
            </view>
            <view class="code-status {{item.posterUrl ? 'ready' : 'pending'}}">
              <text class="status-dot"></text>
              <text>{{item.posterUrl ? '海报可用' : '生成中'}}</text>
            </view>
          </view>
          <view class="code-purpose">
            <text class="cuIcon-qr_code"></text>
            <text>顾客扫码点餐</text>
          </view>
          <view class="code-time">
            <text class="cuIcon-time"></text>
            <text>{{item.createTimeText}}</text>
          </view>
        </view>
      </view>

      <view class="item-actions">
        <view class="action-btn preview" bindtap="previewPoster" data-item="{{item}}" hover-class="control-pressed">
          <text class="cuIcon-pic"></text>
          <text>预览</text>
        </view>
        <view class="action-btn download {{item.posterUrl ? '' : 'is-disabled'}}" bindtap="downloadPoster" data-item="{{item}}" hover-class="control-pressed">
          <text class="cuIcon-down"></text>
          <text>下载</text>
        </view>
        <view class="action-btn delete" bindtap="deleteTableCode" data-id="{{item._id}}" hover-class="control-pressed">
          <text class="cuIcon-delete"></text>
          <text>删除</text>
        </view>
      </view>
    </view>

    <van-empty wx:if="{{tableCodeList.length === 0}}" description="暂无桌码" />
  </view>

  <view class="modal-mask" wx:if="{{showAddModal}}" catchtap="closeAddModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="modal-title">
          <text class="cuIcon-qr_code"></text>
          <text>新建桌码</text>
        </view>
        <view class="modal-close cuIcon-close" bindtap="closeAddModal" hover-class="control-pressed"></view>
      </view>
      <view class="modal-content">
        <view class="form-label">桌码号 <text class="required">*</text></view>
        <view class="input-shell">
          <text class="input-icon cuIcon-scan"></text>
          <input
            class="form-input"
            type="number"
            placeholder="请输入桌码号"
            value="{{newTableNumber}}"
            bindinput="onTableNumberInput"
            focus="{{showAddModal}}"
          />
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeAddModal" hover-class="control-pressed">取消</view>
        <view class="modal-btn confirm" bindtap="confirmAddTableCode" hover-class="control-pressed">确认创建</view>
      </view>
    </view>
  </view>

  <painter
    customStyle="position: absolute; left: -9999rpx;"
    customActionStyle="{{customActionStyle}}"
    dancePalette="{{template}}"
    palette="{{paintPallette}}"
    bind:imgOK="onImgOK"
    bind:touchEnd="touchEnd"
    action="{{action}}"
    use2D="{{true}}"
    widthPixels="520"
  />
</view>
