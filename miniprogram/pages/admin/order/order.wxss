/* pages/admin/order/order.wxss */
.page {
  min-height: 100vh;
  background: #f7f7f7;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 筛选栏 */
.filter-bar {
  background: white;
  border-radius: 16rpx;
  padding: 10rpx 20rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

.refresh-bar {
  margin-top: 10rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 15rpx;
}

.refresh-btn {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d94335;
  color: #d94335;
  font-size: 24rpx;
}

.refresh-tip {
  font-size: 22rpx;
  color: #999;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.04);
}

/* 订单头部 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-user-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #f5f5f5;
}

.user-info-text {
  flex: 1;
}

.user-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 5rpx;
}

.user-phone {
  font-size: 24rpx;
  color: #999;
}

.order-type {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

/* 订单内容 */
.order-content {
  padding: 30rpx;
}

/* 充值订单信息 */
.recharge-info {
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
}

.recharge-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.recharge-item:last-child {
  margin-bottom: 0;
}

.recharge-label {
  font-size: 28rpx;
  color: #666;
}

.recharge-value {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.recharge-value.gift {
  color: #ff6b6b;
}

.recharge-value.total {
  color: #d94335;
  font-size: 36rpx;
}

/* 点餐订单商品列表 */
.goods-list {
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.goods-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.goods-sku {
  font-size: 24rpx;
  color: #38b2ac;
  margin-bottom: 8rpx;
}

/* 商品标签 */
.goods-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #d94335;
  background: rgba(229, 77, 66, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(229, 77, 66, 0.3);
}

.goods-detail {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 28rpx;
  color: #d94335;
  font-weight: bold;
}

.goods-count {
  font-size: 26rpx;
  color: #999;
}

/* 订单底部 */
.order-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: right;
}

.order-info {
  text-align: right;
  margin-bottom: 15rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.order-table-code {
  font-size: 24rpx;
  color: #38b2ac;
  font-weight: 500;
  margin-top: 5rpx;
}

.order-print-status {
  margin-top: 8rpx;
}

.print-status-text {
  font-size: 24rpx;
  font-weight: 500;
}

.print-status-text.printed {
  color: #07c160;
}

.print-status-text.failed {
  color: #ee0a24;
}

.print-status-text.cancelled {
  color: #999;
}

.print-status-text.not-printed {
  color: #ff9500;
}

.order-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.order-price {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 26rpx;
  color: #666;
}

.price-num {
  font-size: 36rpx;
  color: #d94335;
  font-weight: bold;
  margin-left: 10rpx;
}

.action-btns {
  display: flex;
  gap: 15rpx;
}

.action-btn {
  padding: 12rpx 30rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
  text-align: center;
}

.action-btn.delete {
  background: rgba(245, 108, 108, 0.1);
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
}

/* 高级版视觉覆盖 */
.page {
  background: linear-gradient(180deg, #fff7f3 0%, #f6f7f9 240rpx, #f6f7f9 100%);
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.filter-bar {
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.refresh-bar {
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.refresh-btn {
  border-color: rgba(217, 67, 53, 0.34);
  color: #d94335;
  background: #fff4f0;
}

.refresh-tip {
  color: #9aa1ad;
}

.order-list {
  padding: 0;
}

.order-item {
  border-radius: 16rpx;
  border: 1rpx solid rgba(34, 37, 43, 0.05);
  box-shadow: 0 14rpx 34rpx rgba(27, 36, 48, 0.07);
}

.order-header {
  padding: 28rpx;
  border-bottom-color: #ebeef3;
}

.user-avatar {
  border: 4rpx solid #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(27, 36, 48, 0.08);
}

.user-name,
.order-type,
.goods-name {
  color: #22252b;
}

.user-phone,
.order-time {
  color: #9aa1ad;
}

.order-type {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4f0;
  color: #d94335;
  font-size: 24rpx;
}

.recharge-info {
  background: #fbfcfd;
  border: 1rpx solid #ebeef3;
}

.goods-image {
  background: #f0f2f5;
}

.goods-sku,
.order-table-code {
  color: #1f9d8a;
}

.goods-price,
.price-num,
.recharge-value.total {
  color: #d94335;
}

.recharge-value.gift {
  color: #c77a18;
}

.order-footer {
  border-top-color: #ebeef3;
  background: #fbfcfd;
}

.print-status-text.printed {
  color: #2f9e5b;
}

.print-status-text.failed {
  color: #d94335;
}

.print-status-text.not-printed {
  color: #c77a18;
}


