page {
  min-height: 100%;
  background: var(--brand-bg, #f9f9f9);
  color: var(--brand-text, #1a1c1c);
}

.page,
.page view,
.page input,
.page textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.preview-band {
  position: relative;
  padding: 28rpx 24rpx 34rpx;
  overflow: hidden;
  background: var(--brand-red, #8c271e);
}

.preview-label {
  position: relative;
  z-index: 1;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
}

.store-preview {
  position: relative;
  z-index: 1;
  min-height: 124rpx;
  padding: 22rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 16rpx;
  box-shadow: 0 14rpx 34rpx rgba(74, 21, 18, 0.2);
}

.store-mark {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 34rpx;
  background: #8c271e;
  border-radius: 12rpx;
}

.store-copy {
  min-width: 0;
  flex: 1;
}

.store-status {
  min-width: 104rpx;
  min-height: 52rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 23rpx;
  font-weight: 750;
  border-radius: 14rpx;
}

.store-status.open { color: #287b61; background: #e7f4ef; }
.store-status.closed { color: #8c271e; background: #f7ebe8; }

.store-name,
.store-welcome {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.store-name {
  color: #242426;
  font-size: 31rpx;
  font-weight: 750;
}

.store-welcome {
  margin-top: 8rpx;
  color: #85858a;
  font-size: 23rpx;
}

.form-section {
  padding: 32rpx 24rpx 16rpx;
  background: #ffffff;
}

.section-heading {
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #28282b;
  font-size: 30rpx;
  font-weight: 750;
}

.heading-icon {
  color: #8c271e;
  font-size: 30rpx;
}

.form-item {
  position: relative;
  margin-bottom: 28rpx;
}

.business-switch-row {
  min-height: 112rpx;
  padding-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-top: 1rpx solid #ebe8e6;
}

.business-switch-copy { min-width: 0; flex: 1; }
.business-switch-row .form-label { margin-bottom: 6rpx; }
.business-switch-desc { color: #656461; font-size: 23rpx; line-height: 1.5; }

.form-label {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #3a3a3e;
  font-size: 26rpx;
  font-weight: 650;
}

.required {
  color: #8c271e;
}

.form-input,
.form-textarea {
  width: 100%;
  color: #28282b;
  font-size: 28rpx;
  background: #f7f7f8;
  border: 1rpx solid #e6e6e8;
  border-radius: 12rpx;
}

.form-input {
  height: 92rpx;
  padding: 0 120rpx 0 24rpx;
}

.form-textarea {
  height: 176rpx;
  padding: 22rpx 24rpx 48rpx;
  line-height: 1.55;
}

.field-counter {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  color: #a2a2a7;
  font-size: 21rpx;
}

.field-counter.input-counter {
  bottom: 34rpx;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e9e9eb;
  box-shadow: 0 -10rpx 30rpx rgba(34, 34, 38, 0.08);
}

.save-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 750;
  background: #8c271e;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 18rpx rgba(140, 39, 30, 0.2);
}

.save-btn.is-saving {
  opacity: 0.66;
}

.control-pressed {
  opacity: 0.72;
}

.save-btn {
  border-radius: var(--control-radius);
}

/* 原型统一收束：店铺设置 */
.form-section,
.store-preview {
  border-radius: 20rpx;
}

.form-input,
.form-textarea {
  min-height: 88rpx;
  border-radius: var(--field-radius) !important;
}

.save-bar {
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top-color: #ebeef3;
}

.save-btn {
  height: 88rpx;
  border-radius: var(--control-radius) !important;
}
