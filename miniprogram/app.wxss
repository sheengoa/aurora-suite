/**app.wxss**/
@import './components/colorui/animation.wxss';
@import './components/colorui/icon.wxss';
@import './components/colorui/main.wxss';
@import './components/colorui/vertical-nav.wxss';

/* 全局红色主题样式 */
page {
  --theme-color: #d94335;
  --theme-color-dark: #a82f28;
  --theme-color-light: #f36a5d;
  --theme-soft: #fff4f0;
  --theme-warm: #fff8f3;
  --accent-color: #1f9d8a;
  --warning-color: #c77a18;
  --success-color: #2f9e5b;
  --text-main: #22252b;
  --text-sub: #69707d;
  --text-muted: #9aa1ad;
  --line-color: #ebeef3;
  --card-bg: #ffffff;
  --page-bg: #f6f7f9;
  --card-shadow: 0 12rpx 34rpx rgba(27, 36, 48, 0.07);
  --soft-shadow: 0 8rpx 22rpx rgba(217, 67, 53, 0.16);
  --theme-gradient: linear-gradient(135deg, #b9322a 0%, #d94335 56%, #f36a5d 100%);
  background-color: #f6f7f9;
  color: #22252b;
  font-size: 28rpx;
}

.container {
  padding: 20rpx;
}

/* 主题按钮 */
.btn-theme {
  background: var(--theme-gradient);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  box-shadow: var(--soft-shadow);
}

.btn-theme-plain {
  background: white;
  color: var(--theme-color);
  border: 2rpx solid rgba(217, 67, 53, 0.26);
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--card-shadow);
  border: 1rpx solid rgba(34, 37, 43, 0.05);
}

/* 标签 */
.tag-red {
  background: var(--theme-color);
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* 价格样式 */
.price {
  color: var(--theme-color);
  font-weight: bold;
}

.price-symbol {
  font-size: 24rpx;
}

.price-num {
  font-size: 36rpx;
}

/* 徽章 */
.badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: var(--theme-color);
  color: white;
  border-radius: 50%;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 20rpx;
  padding: 0 8rpx;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--line-color);
  margin: 20rpx 0;
}

input,
textarea {
  box-sizing: border-box;
}

.add-btn,
.save-btn,
.bind-btn,
.refresh-btn,
.action-btn,
.modal-btn,
.submit-btn,
.recharge-btn,
.cart-settle-btn,
.settle-btn,
.add-cart-btn {
  letter-spacing: 0;
}

.modal-dialog {
  border-radius: 16rpx !important;
  box-shadow: 0 30rpx 90rpx rgba(18, 24, 33, 0.22);
}

.form-input,
.form-textarea,
.password-input,
.search-input,
.option-input {
  border-color: #e6e9ef !important;
  border-radius: 12rpx !important;
  background: #fbfcfd;
}

.section-title,
.header-title,
.modal-title {
  letter-spacing: 0;
}
