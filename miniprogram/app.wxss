@import './components/colorui/animation.wxss';
@import './components/colorui/icon.wxss';
@import './components/colorui/main.wxss';
@import './components/colorui/vertical-nav.wxss';
@import './styles/aurora-theme.wxss';

page {
  --brand-red: #8c271e;
  --brand-red-dark: #6f1f19;
  --brand-red-soft: #f7ebe8;
  --brand-red-wash: #fcf5f3;
  --brand-bg: #f9f9f9;
  --brand-surface: #ffffff;
  --brand-text: #1a1c1c;
  --brand-sub: #656461;
  --brand-muted: #9ca3af;
  --brand-line: #ebe8e6;
  --brand-success: #287b61;
  --brand-warning: #a66a23;
  --brand-error: #b3261e;
  --theme-color: #8c271e;
  --theme-color-dark: #6f1f19;
  --theme-color-light: #b65c51;
  --theme-soft: #f7ebe8;
  --theme-warm: #fcf5f3;
  --accent-color: #287b61;
  --warning-color: #a66a23;
  --success-color: #287b61;
  --text-main: #1a1c1c;
  --text-sub: #656461;
  --text-muted: #9ca3af;
  --line-color: #ebe8e6;
  --card-bg: #ffffff;
  --page-bg: #f9f9f9;
  --card-shadow: 0 12rpx 34rpx rgba(31, 25, 22, 0.07);
  --soft-shadow: 0 10rpx 24rpx rgba(140, 39, 30, 0.16);
  --theme-gradient: #8c271e;
  --space-1: 8rpx;
  --space-2: 12rpx;
  --space-3: 16rpx;
  --space-4: 20rpx;
  --space-5: 24rpx;
  --space-6: 32rpx;
  --field-radius: 24rpx;
  --chip-radius: 999rpx;
  --control-radius: 26rpx;
  --card-radius: 24rpx;
  --floating-radius: 40rpx;
  --modal-radius: 28rpx;
  --control-height: 88rpx;
  --tabbar-height: 120rpx;
  min-height: 100%;
  background: var(--brand-bg);
  color: var(--brand-text);
  font-size: 28rpx;
}

button::after { border: 0; }

button,
input,
textarea { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }

button,
view,
text,
input,
textarea { box-sizing: border-box; }

.container { padding: 24rpx; }

.btn-theme,
.btn-theme-plain {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--control-radius);
  padding: 0 40rpx;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms ease;
}

.btn-theme { color: #fff; background: var(--brand-red); box-shadow: var(--soft-shadow); }
.btn-theme-plain { color: var(--brand-red); background: #fff; border: 2rpx solid rgba(140, 39, 30, 0.24); }
.btn-theme:active,
.btn-theme-plain:active { transform: scale(0.97); opacity: 0.92; }

.card {
  margin-bottom: 20rpx;
  padding: 30rpx;
  background: var(--brand-surface);
  border: 1rpx solid rgba(26, 28, 28, 0.05);
  border-radius: var(--card-radius);
  box-shadow: var(--card-shadow);
}

.tag-red { padding: 4rpx 12rpx; color: #fff; background: var(--brand-red); border-radius: 8rpx; font-size: 22rpx; }
.price { color: var(--brand-red); font-weight: 700; }
.price-symbol { font-size: 24rpx; }
.price-num { font-size: 36rpx; }
.badge { position: absolute; top: -10rpx; right: -10rpx; min-width: 36rpx; height: 36rpx; padding: 0 8rpx; color: #fff; background: var(--brand-red); border-radius: 50%; font-size: 20rpx; line-height: 36rpx; text-align: center; }
.divider { height: 1rpx; margin: 20rpx 0; background: var(--brand-line); }

.modal-dialog { border-radius: var(--modal-radius) !important; box-shadow: 0 30rpx 90rpx rgba(18, 24, 33, 0.22); }

.form-input,
.form-textarea,
.password-input,
.search-input,
.option-input { background: #fff !important; border-color: #e6e1de !important; border-radius: var(--field-radius) !important; }

.add-btn,
.save-btn,
.bind-btn,
.refresh-btn,
.action-btn,
.modal-btn,
.submit-btn,
.recharge-btn,
.cart-settle-btn,
.settle-btn,
.add-cart-btn,
.checkout-btn,
.primary-button,
.secondary-button,
.buy-button,
.add-button,
.empty-action {
  min-height: var(--control-height);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--control-radius) !important;
  line-height: 1.2;
  transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms ease, background 180ms ease;
}

.add-btn:active,
.save-btn:active,
.bind-btn:active,
.refresh-btn:active,
.modal-btn:active,
.submit-btn:active,
.recharge-btn:active,
.cart-settle-btn:active,
.settle-btn:active,
.add-cart-btn:active,
.checkout-btn:active,
.primary-button:active,
.secondary-button:active,
.buy-button:active,
.add-button:active,
.empty-action:active { transform: scale(0.97); }

.modal-btn.cancel,
.secondary-button { color: var(--brand-sub); background: #f3f1ef; border: 1rpx solid #e7e2df; }
.section-title,
.header-title,
.modal-title { letter-spacing: 0; }
.tab-page-padding { padding-bottom: calc(var(--tabbar-height) + env(safe-area-inset-bottom)); }
.control-pressed { opacity: 0.72; transform: scale(0.98); }
.soft-control-pressed { opacity: 0.72; background: #f0edeb !important; }

/* Vant / ColorUI 的页面级覆盖，只改变品牌令牌，不修改第三方源码。 */
.van-button--danger,
.van-tag--danger { background: var(--brand-red) !important; border-color: var(--brand-red) !important; }
.van-tabs__line { background: var(--brand-red) !important; }
.van-empty__description { color: var(--brand-sub) !important; }
