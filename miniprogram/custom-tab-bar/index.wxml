<view class="tabbar" role="navigation" aria-label="主要导航">
  <view class="tab-marker" style="transform: translateX({{selected * 100}}%);"></view>
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="tab-item-pressed"
    hover-stay-time="100"
    aria-role="button"
    aria-label="{{item.text}}">
    <view class="tab-icon-box">
      <text class="tab-icon {{item.icon}}" aria-hidden="true"></text>
    </view>
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
