<view wx:if="{{!interactionLocked}}" class="tabbar" role="navigation" aria-label="主要导航">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="tab-item-pressed"
    hover-stay-time="100"
    aria-role="button"
    aria-label="{{item.text}}">
    <view class="tab-icon-box">
      <view class="tab-selection-wave" aria-hidden="true"></view>
      <image class="tab-icon tab-icon-idle" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" style="width: 36rpx; height: 36rpx;"></image>
      <image class="tab-icon tab-icon-selected" src="{{item.iconActive}}" mode="aspectFit" aria-hidden="true" style="width: 36rpx; height: 36rpx;"></image>
    </view>
    <text class="tab-label">{{item.text}}</text>
  </view>
</view>
