.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  height: calc(120rpx + env(safe-area-inset-bottom));
  padding: 24rpx 56rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid rgba(26, 28, 28, 0.07);
  box-shadow: 0 -10rpx 30rpx rgba(26, 28, 28, 0.04);
}

.tab-item {
  position: relative;
  min-width: 0;
  min-height: 88rpx;
  flex: 1;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  flex-direction: column;
  color: #9ca3af;
  background: transparent;
  transition: color 240ms cubic-bezier(0.16, 1, 0.3, 1), opacity 160ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-icon-box {
  position: relative;
  width: 44rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-selection-wave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 50rpx;
  height: 50rpx;
  margin-top: -25rpx;
  margin-left: -25rpx;
  opacity: 0;
  border-radius: 50%;
  background: rgba(140, 39, 30, 0.12);
  transform: scale(0.35);
  pointer-events: none;
}

.tab-icon {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  display: block;
  transform-origin: 50% 72%;
  transition: opacity 220ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-icon-idle { opacity: 1; transform: translateY(0) scale(1); }
.tab-icon-selected { opacity: 0; transform: translateY(5rpx) scale(0.78); }

.tab-label {
  margin-top: 12rpx;
  opacity: 0.82;
  font-size: 18rpx;
  line-height: 1;
  white-space: nowrap;
  transform: translateY(1rpx);
  transition: opacity 220ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-item.active { color: #8c271e; font-weight: 700; }
.tab-item.active .tab-icon-idle { opacity: 0; transform: translateY(-2rpx) scale(0.9); }
.tab-item.active .tab-icon-selected { opacity: 1; animation: aurora-tab-icon-settle 420ms cubic-bezier(0.16, 1, 0.3, 1) both; }
.tab-item.active .tab-selection-wave { animation: aurora-tab-wave 440ms cubic-bezier(0.16, 1, 0.3, 1) both; }
.tab-item.active .tab-label { opacity: 1; animation: aurora-tab-label-settle 360ms cubic-bezier(0.16, 1, 0.3, 1) both; }
.tab-item-pressed { opacity: 0.68; transform: scale(0.96); }

@keyframes aurora-tab-icon-settle {
  0% { opacity: 0; transform: translateY(6rpx) scale(0.78); }
  42% { opacity: 1; transform: translateY(-3rpx) scale(1.08); }
  72% { transform: translateY(1rpx) scale(0.98); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes aurora-tab-wave {
  0% { opacity: 0; transform: scale(0.35); }
  30% { opacity: 1; transform: scale(0.82); }
  100% { opacity: 0; transform: scale(1.45); }
}

@keyframes aurora-tab-label-settle {
  0% { opacity: 0.48; transform: translateY(4rpx); }
  64% { opacity: 1; transform: translateY(-1rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
